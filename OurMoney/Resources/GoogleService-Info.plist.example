<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  PLACEHOLDER — DO NOT EDIT THIS FILE.

  Real file required: Firebase Console → Project Settings → Add iOS app
  (bundle id: com.devanshu.ourmoney.ios) → download GoogleService-Info.plist →
  save it as OurMoney/Resources/GoogleService-Info.plist (replace nothing else).

  The real file MUST come from the SAME Firebase project as the Android app
  (see ourmoney/app/google-services.json) so that Android and iOS share users,
  households, codes and all financial data.

  The values below are shape examples only — FirebaseApp.configure() will fail
  until the real file is present.
-->
<plist version="1.0">
<dict>
	<key>BUNDLE_ID</key>
	<string>com.devanshu.ourmoney.ios</string>
	<key>CLIENT_ID</key>
	<string>000000000000-abcdefghijklmnopabcdefghijklmnop12345678.apps.googleusercontent.com</string>
	<key>REVERSED_CLIENT_ID</key>
	<string>com.googleusercontent.apps.000000000000-abcdefghijklmnopabcdefghijklmnop12345678</string>
	<key>API_KEY</key>
	<string>AIzaSyEXAMPLE-REPLACE-ME-000000000000000</string>
	<key>GCM_SENDER_ID</key>
	<string>000000000000</string>
	<key>PLIST_VERSION</key>
	<string>1</string>
	<key>PROJECT_ID</key>
	<string>your-firebase-project-id</string>
	<key>STORAGE_BUCKET</key>
	<string>your-firebase-project-id.appspot.com</string>
	<key>IS_ADS_ENABLED</key>
	<false/>
	<key>IS_ANALYTICS_ENABLED</key>
	<false/>
	<key>GOOGLE_APP_ID</key>
	<string>1:000000000000:ios:0000000000000000000000</string>
</dict>
</plist>
